POSTGRES_USER=doclink
POSTGRES_PASSWORD=doclink
POSTGRES_DB=doclink
DATABASE_URL=postgresql+psycopg://doclink:doclink@db:5432/doclink
APP_USER=admin
APP_PASSWORD=change-me
SECRET_KEY=change-me

YC_API_KEY=
YC_FOLDER_ID=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_API_URL=https://api.giga.chat/v1
# PEM с доверенной цепочкой НУЦ; certs/ копируется в /app/certs при сборке образа.
GIGACHAT_CA_BUNDLE=
LLM_PROVIDER=mock
LLM_TIMEOUT_SECONDS=120

PAID_CALLS_ENABLED=false
BUDGET_RUB=0
# Если задан хотя бы один, для каждого используемого облачного провайдера нужен свой лимит.
YANDEX_BUDGET_RUB=0
GIGACHAT_BUDGET_RUB=0

OLLAMA_URL=http://ollama:11434
# BGE-M3 CPU: сначала make embedding-download; обычное кодирование без сети.
EMBEDDING_CACHE_DIR=/data/models
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_CPU_THREADS=2
FILES_DIR=/data/files
MAX_FILE_BYTES=26214400
MAX_PDF_PAGES=100
OCR_DPI=200
MAX_RENDER_PIXELS=20000000
OCR_TIMEOUT_SECONDS=30
MAX_DOCX_UNCOMPRESSED_BYTES=104857600

MOCK1C_URL=http://mock1c:8001
MOCK1C_ENABLED=true
MOCK1C_POLL_SECONDS=30
MOCK1C_TIMEOUT_SECONDS=10
WORKER_HEARTBEAT_SECONDS=30
