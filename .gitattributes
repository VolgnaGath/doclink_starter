# Corpus fingerprints include bytes; preserve the supplied formats on every checkout.
/corpus/**/*.txt text eol=lf
/corpus/real/documents.csv text eol=lf
/corpus/real/links.csv text eol=lf
/corpus/real/manifest.csv text eol=crlf
/corpus/synth/*.csv text eol=crlf
/corpus/synth_extra/*.csv text eol=crlf
/corpus/synth_holdout/*.csv text eol=crlf
# Delivery manifest hashes exported bytes, including the CSV line endings.
/docs/reports/stage8-*.csv -text whitespace=cr-at-eol
/docs/reports/holdout-*.csv -text whitespace=cr-at-eol
